{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Contacts App",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "This is a documentation for contacts app"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    },
    {
      "url": "https://your-production-url.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Operations about contacts."
    },
    {
      "name": "Auth",
      "description": "Auth operations."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
  "/contacts": {
    "get": { "$ref": "../swagger/paths/contacts/get.yaml" },
    "post": { "$ref": "../swagger/paths/contacts/post.yaml" }
  },
  "/contacts/{contactId}": {
    "get": { "$ref": "../swagger/paths/contacts/{contactId}/get.yaml" },
    "patch": { "$ref": "../swagger/paths/contacts/{contactId}/patch.yaml" },
    "delete": { "$ref": "../swagger/paths/contacts/{contactId}/delete.yaml" }
},
    "/auth/register": { "$ref": "../swagger/paths/auth/register.yaml" },
    "/auth/login": { "$ref": "../swagger/paths/auth/login.yaml" }
  }
}
